{
  "name": "api",
  "version": "1.0.0",
  "description": "AVERON commerce backend API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "prisma generate --schema=../../prisma/schema.prisma && tsc --project tsconfig.json",
    "start": "sh entrypoint.sh",
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=../../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=../../prisma/schema.prisma",
    "prisma:seed": "tsx ../../prisma/seed.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@fastify/auth": "^5.1.1",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@fastify/websocket": "^11.3.1",
    "@prisma/client": "^5.22.0",
    "@sinclair/typebox": "^0.31.0",
    "argon2": "^0.45.1",
    "cloudinary": "^2.10.1",
    "dotenv": "^16.0.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "file-type": "^21.3.1",
    "ioredis": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "otpauth": "^9.5.2",
    "pino": "^8.0.0",
    "pino-pretty": "^10.0.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "undici": "^6.28.1",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
