# apps/api/.env.example

NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/averon
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret_jwt_key_for_dev_only_minimum_32_chars
REFRESH_SECRET=supersecret_refresh_key_for_dev_only_min_32_chars
# Required to enroll admin TOTP. Generate a private 32-byte hex key with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
ENCRYPTION_KEY=32_byte_encryption_key_for_dev_only_1234567890

# Публичный URL сайта (используется для ссылок восстановления пароля)
PUBLIC_SITE_URL=https://averon-frontend-three.vercel.app

# CORS — список доменов через запятую
# Добавь домены фронтенда и админ-панели
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://averon-frontend-three.vercel.app,https://averon-admin-panel.vercel.app

# Email сервис Resend (обязательно для отправки писем восстановления пароля)
# Получить ключ на https://resend.com после верификации домена
RESEND_API_KEY=

# Google OAuth (client-side @react-oauth/google)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Telegram 2FA Bot (для авторизации в админ-панели)
TELEGRAM_TOKEN_2FA=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_private_telegram_chat_id
PARSER_IMPORT_TOKEN=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
TELEGRAM_ADMIN_CHAT_ID=your_telegram_admin_chat_id_here

# Media Storage (local или cloudinary)
# Если указаны ключи CLOUDINARY_*, бэкенд автоматически использует Cloudinary
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=averon/products
STORAGE_PATH=/tmp/uploads
MAX_FILE_SIZE=10485760

# AI сервис
OLLAMA_BASE_URL=http://localhost:11434
AI_SERVICE_URL=http://localhost:8000
OLLAMA_MODEL=llama3
AI_PRODUCT_API_URL=
AI_PRODUCT_API_KEY=
AI_PRODUCT_MODEL=gpt-4o-mini

# Неактивированные интеграции: включаются только отдельным deployment-решением
FEATURE_AI_PRODUCT_FILL=false
FEATURE_1688_PARSER=false
FEATURE_PINDUODUO_PARSER=false
FEATURE_IPOST=false
FEATURE_N8N=false
FEATURE_TELEGRAM_PRODUCT_PUBLISH=false
FEATURE_AUTO_CURRENCY=false
FEATURE_SMS_VERIFICATION=false
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=AVERON
TELEGRAM_ADMIN_BOT=
TELEGRAM_CHANNEL_ID=

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
