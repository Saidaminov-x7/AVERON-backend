# apps/api/.env.example

NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/averon
REDIS_URL=redis://localhost:6379
JWT_SECRET=
REFRESH_SECRET=
# Required to enroll admin TOTP. Supply a private 32-byte hex key at runtime.
# Generate locally with: openssl rand -hex 32
ENCRYPTION_KEY=

# Публичный URL сайта (используется для ссылок восстановления пароля)
PUBLIC_SITE_URL=https://averon.uz

# CORS — список доменов через запятую
# Добавь домены фронтенда и админ-панели
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://averon.uz,https://averon-admin-panel.vercel.app

# Email сервис Resend (обязательно для отправки писем восстановления пароля)
# Получить ключ на https://resend.com после верификации домена
RESEND_API_KEY=

# Google OAuth (client-side @react-oauth/google)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Telegram 2FA Bot (для авторизации в админ-панели)
TELEGRAM_TOKEN_2FA=
TELEGRAM_ADMIN_CHAT_ID=
PARSER_IMPORT_TOKEN=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Media Storage (local или cloudinary)
# Если указаны ключи CLOUDINARY_*, бэкенд автоматически использует Cloudinary
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=averon/products
STORAGE_PATH=/tmp/uploads
MAX_FILE_SIZE=10485760
PRISMA_BASELINE_INITIAL_MIGRATION=false

# AI сервис
OLLAMA_BASE_URL=http://localhost:11434
AI_SERVICE_URL=http://localhost:8000
OLLAMA_MODEL=llama3
AI_PRODUCT_API_URL=
AI_PRODUCT_API_KEY=
AI_PRODUCT_MODEL=gpt-4o-mini
AI_PROVIDER=openai-compatible
AI_API_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=10000

# Shopping AI is opt-in and remains unavailable without a real provider URL and key.
FEATURE_AI_SEARCH=false
FEATURE_STYLE_ASSISTANT=false
FEATURE_COMPLETE_THE_LOOK=false
FEATURE_RECOMMENDATIONS=false
FEATURE_PERSONALIZED_RECOMMENDATIONS=false
FEATURE_RECENTLY_VIEWED=false
AI_REQUEST_RATE_LIMIT_MAX=5
AI_REQUEST_RATE_LIMIT_WINDOW_SEC=60

# Неактивированные интеграции: включаются только отдельным deployment-решением
FEATURE_AI_PRODUCT_FILL=false
FEATURE_1688_PARSER=false
FEATURE_PINDUODUO_PARSER=false
FEATURE_IPOST=false
FEATURE_N8N=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
FEATURE_TELEGRAM_PRODUCT_PUBLISH=false
FEATURE_AUTO_CURRENCY=false
FEATURE_SMS_VERIFICATION=false
FEATURE_VISUAL_SEARCH=false
FEATURE_SIMILAR_PRODUCTS=false
FEATURE_IMAGE_EMBEDDINGS=false
# These remain unavailable until a real embedding provider and compatible vector storage are configured.
VISUAL_SEARCH_MAX_IMAGE_MB=10
VISUAL_SEARCH_RATE_LIMIT_MAX=5
VISUAL_SEARCH_RATE_LIMIT_WINDOW_SEC=60
VISUAL_SEARCH_PROVIDER_TIMEOUT_MS=10000
ACTIVE_IMAGE_EMBEDDING_VERSION=v1
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=AVERON
TELEGRAM_ADMIN_BOT=
TELEGRAM_MINI_APP_BOT_TOKEN=
TELEGRAM_MINI_APP_URL=
TELEGRAM_CHANNEL_ID=

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
