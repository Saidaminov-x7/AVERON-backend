{
  "version": 1,
  "scope": "Priority auth, order, payment-adjacent, and admin mutation routes. This is a curated subset of the full AST registry in ../AVERON_security_tests/docs/api-endpoint-registry.json.",
  "endpoints": [
    { "method": "POST", "path": "/auth/login", "access": "PUBLIC", "testCoverageStatus": "PARTIAL", "testFiles": ["apps/api/src/modules/auth/__tests__/auth.test.ts", "apps/api/src/modules/auth/__tests__/login-throttle.test.ts"], "note": "Login behavior and throttling covered; no-token/role matrix is not applicable to login." },
    { "method": "POST", "path": "/auth/logout", "access": "AUTHENTICATED_USER", "testCoverageStatus": "NOT_TESTED", "testFiles": [] },
    { "method": "GET", "path": "/auth/me", "access": "AUTHENTICATED_USER", "testCoverageStatus": "NOT_TESTED", "testFiles": [] },
    { "method": "GET", "path": "/auth/me/export", "access": "AUTHENTICATED_USER", "testCoverageStatus": "PARTIAL", "testFiles": ["apps/api/src/modules/auth/__tests__/unauthenticated-data-security.test.ts", "apps/api/src/modules/auth/__tests__/export-security.test.ts"], "note": "Unauthenticated request and export security covered; full role matrix is not applicable." },
    { "method": "PATCH", "path": "/auth/me/body-profile", "access": "AUTHENTICATED_USER", "testCoverageStatus": "NOT_TESTED", "testFiles": [] },
    { "method": "GET", "path": "/admin/users", "access": "ADMIN", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/admin/admin-users-security.test.ts"], "coverage": ["missing token -> 401", "user/unsupported role -> 403", "authorized admin -> expected handler status"] },
    { "method": "PATCH", "path": "/admin/users/:id/block", "access": "ADMIN_MUTATION", "testCoverageStatus": "PARTIAL", "testFiles": ["apps/api/src/modules/admin/admin-users-security.test.ts"] },
    { "method": "POST", "path": "/admin/users/:id/restore", "access": "ADMIN_MUTATION", "testCoverageStatus": "PARTIAL", "testFiles": ["apps/api/src/modules/admin/user-restore-security.test.ts"] },
    { "method": "GET", "path": "/admin/theme", "access": "SUPER_ADMIN", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/admin/priority-route-coverage.test.ts"], "coverage": ["missing token -> 401", "ADMIN -> 403", "SUPER_ADMIN -> 200"] },
    { "method": "PATCH", "path": "/admin/theme", "access": "SUPER_ADMIN_MUTATION", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/admin/priority-route-coverage.test.ts"], "coverage": ["missing token -> 401", "ADMIN -> 403", "valid DTO as SUPER_ADMIN -> 200"] },
    { "method": "GET", "path": "/admin/admin-theme", "access": "SUPER_ADMIN", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/admin/priority-route-coverage.test.ts"], "coverage": ["missing token -> 401", "ADMIN -> 403", "SUPER_ADMIN -> 200"] },
    { "method": "PATCH", "path": "/admin/admin-theme", "access": "SUPER_ADMIN_MUTATION", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/admin/priority-route-coverage.test.ts"], "coverage": ["missing token -> 401", "ADMIN -> 403", "valid DTO as SUPER_ADMIN -> 200"] },
    { "method": "GET", "path": "/admin/staff", "access": "SUPER_ADMIN", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/admin/priority-route-coverage.test.ts"], "coverage": ["missing token -> 401", "ADMIN -> 403", "SUPER_ADMIN -> 200"] },
    { "method": "POST", "path": "/admin/staff", "access": "SUPER_ADMIN_MUTATION", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/admin/priority-route-coverage.test.ts"], "coverage": ["missing token -> 401", "ADMIN -> 403", "valid existing-user role assignment as SUPER_ADMIN -> 200"] },
    { "method": "PATCH", "path": "/admin/staff/:id", "access": "SUPER_ADMIN_MUTATION", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/admin/priority-route-coverage.test.ts"], "coverage": ["missing token -> 401", "ADMIN -> 403", "valid role update as SUPER_ADMIN -> 200"] },
    { "method": "DELETE", "path": "/admin/staff/:id", "access": "SUPER_ADMIN_MUTATION", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/admin/priority-route-coverage.test.ts"], "coverage": ["missing token -> 401", "ADMIN -> 403", "valid access revocation as SUPER_ADMIN -> 204"] },
    { "method": "DELETE", "path": "/admin/users/:id", "access": "SUPER_ADMIN_MUTATION", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/admin/priority-route-coverage.test.ts"], "coverage": ["missing token -> 401", "ADMIN -> 403", "valid delete request as SUPER_ADMIN -> 200"] },
    { "method": "GET", "path": "/api/v1/admin/ai-status", "access": "ADMIN", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/admin/priority-route-coverage.test.ts"], "coverage": ["missing token -> 401", "SUPPORT -> 403", "ADMIN -> 200"] },
    { "method": "GET", "path": "/api/v1/admin/recommendation-status", "access": "ADMIN", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/admin/priority-route-coverage.test.ts"], "coverage": ["missing token -> 401", "SUPPORT -> 403", "ADMIN -> 200"] },
    { "method": "GET", "path": "/api/v1/admin/integration-diagnostics", "access": "ADMIN", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/admin/priority-route-coverage.test.ts"], "coverage": ["missing token -> 401", "SUPPORT -> 403", "ADMIN -> 200"] },
    { "method": "POST", "path": "/api/v1/checkout", "access": "AUTHENTICATED_USER", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/commerce/__tests__/checkout-orders.test.ts"], "coverage": ["authorized checkout and validation/error cases"] },
    { "method": "GET", "path": "/api/v1/orders/me", "access": "AUTHENTICATED_USER", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/commerce/__tests__/checkout-orders.test.ts"] },
    { "method": "GET", "path": "/api/v1/orders/me/:orderNumber", "access": "AUTHENTICATED_USER", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/commerce/__tests__/checkout-orders.test.ts"], "coverage": ["other customer's order is denied"] },
    { "method": "POST", "path": "/api/v1/orders/me/:orderNumber/cancel", "access": "AUTHENTICATED_USER", "testCoverageStatus": "TESTED", "testFiles": ["apps/api/src/modules/commerce/__tests__/checkout-orders.test.ts"], "coverage": ["owner and invalid state transitions"] }
  ]
}
