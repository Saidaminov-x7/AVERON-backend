{
  "name": "averon-backend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm --filter api build",
    "start": "sh apps/api/entrypoint.sh",
    "dev": "pnpm --filter api dev",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:seed": "pnpm --filter api prisma:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "argon2": "^0.45.1",
    "prisma": "^5.22.0",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@^2": "2.4.7",
      "fast-uri@^3": "3.1.8",
      "brace-expansion@^1": "1.1.21",
      "brace-expansion@^2": "2.1.7",
      "minimatch@9": "9.0.7",
      "qs@6": "6.16.0",
      "js-yaml@4": "4.3.2",
      "fast-copy": "3.1.0"
    }
  }
}
